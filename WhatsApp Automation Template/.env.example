# ==============================================================================
# White-Label Client Deployment Environment Template
# ==============================================================================

# 1. Server Environment
PORT=4000
NODE_ENV=production

# 2. Database & RAG Vector Store (Supabase)
# Get these from: Supabase Project Settings -> API
SUPABASE_URL=https://your-client-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_client_supabase_service_role_key

# 3. Primary AI Intelligence (Google Gemini 2.5 Flash)
# Get this from: https://aistudio.google.com/
GEMINI_API_KEY=your_client_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# 4. Fallback AI Intelligence (Optional: OpenAI GPT-4o-mini)
OPENAI_API_KEY=sk-your_optional_openai_fallback_key
LLM_PROVIDER=gemini

# 5. Meta WhatsApp Cloud API
# Get these from: Meta Developers -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=your_meta_system_user_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_client_whatsapp_phone_number_id
WHATSAPP_WABA_ID=your_client_whatsapp_business_account_id
WHATSAPP_VERIFY_TOKEN=whatsapp_sales_assistant_verify_token

# 6. Google Calendar (Instant Booking Sync)
# JSON string of Google Service Account or OAuth Token
GOOGLE_CALENDAR_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
DEFAULT_CALENDAR_ID=primary

# 7. Clinic Owner Morning Executive Briefing Alerts
OWNER_NOTIFICATION_PHONE=+447911123456
OWNER_NOTIFICATION_EMAIL=owner@clientclinic.com
CLINIC_NAME=Apex Dental Care
CLINIC_TIMEZONE=Europe/London
